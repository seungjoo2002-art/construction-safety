# ============================================================
# 프런트엔드(Render Static Site) 빌드 시 scripts/generate-env.js가 읽는 값입니다.
# 전부 공개되어도 되는 정보입니다(비밀 토큰 아님) — Render Static Site "Environment"
# 탭에 이 이름 그대로 등록하세요. 로컬 파일로 .env를 만들어도 자동으로 읽지는
# 않습니다(이 저장소엔 dotenv 로더가 없음) — 로컬 테스트는 README를 참고해
# "HF_DATASET_ID=... node scripts/generate-env.js"처럼 직접 값을 넘겨 실행하세요.
# ============================================================

# Hugging Face에 올린 사고 사례 데이터셋의 repo id (예: your-username/construction-incidents)
# README.md "Hugging Face 데이터셋 준비" 절차를 먼저 완료해야 값이 생깁니다.
HF_DATASET_ID=

# 대부분 기본값 그대로 두면 됩니다.
HF_DATASET_CONFIG=default
HF_DATASET_SPLIT=train
HF_API_BASE=https://datasets-server.huggingface.co

# ============================================================
# Backend(Render Web Service)는 별도 서비스입니다 — 아래는 이 저장소가 아니라
# Backend Web Service 쪽 Render 대시보드 Environment 탭에 등록하는 값입니다.
# (비밀값이므로 이 파일에 실제 값을 절대 적지 마세요)
# ============================================================
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# HF_TOKEN=
